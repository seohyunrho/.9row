# Track only the current application and its development documents.
/*
!/.gitignore
!/.env.example
!/README.md
!/asset-prompt.md
!/index.html
!/server.mjs
!/launch.mjs
!/시작.cmd
!/package.json
!/package-lock.json
!/src/
!/lib/
!/public/
!/scripts/
!/extension/
!/tests/
!/docs/
!/api/
!/supabase/
!/vercel.json
!/.vercelignore

# Local data, credentials and generated files never belong in Git.
node_modules/
dist/
.data/
.env
.env.*
!/.env.example
.vercel/
versions/
artifacts/
*.sqlite
*.sqlite-*
*.db
*.db-*
*.log
*.pem
*.key
gemini-private.json
dart-private.json
extension-token
Thumbs.db
.DS_Store

# Preserve old screenshots and design assets locally only.
/preview-*
/public/office-rug-colors-v34.png
/public/office-no-corner-plant-v33.png
/public/office-no-corner-plants-v33b.png
/extension/SPEC-v02.md
/extension/SPEC-v03.md

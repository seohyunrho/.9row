{
  "manifest_version": 3,
  "name": "모아 · 지원서 입력 도우미",
  "description": "저장한 학력·자격증을 미리 확인하고 S-OIL·HS효성·현대오토에버 지원서의 일반 입력란에 채웁니다. 실제 양식 호환은 확인 중이며, 최종 제출은 하지 않습니다.",
  "version": "0.2.36",
  "icons": {
    "16": "icons/moa-16.png",
    "32": "icons/moa-32.png",
    "48": "icons/moa-48.png",
    "128": "icons/moa-128.png"
  },
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "http://127.0.0.1:4318/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "모아 지원서 입력 도우미",
    "default_icon": {
      "16": "icons/moa-16.png",
      "32": "icons/moa-32.png",
      "48": "icons/moa-48.png",
      "128": "icons/moa-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4317/extension-test.html"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

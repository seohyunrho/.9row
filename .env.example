# Copy this file to .env on your own computer, then fill in your own key.
# Never commit .env or a real API key. This example contains no credentials.
PORT=4317
MOA_DATA_DIR=.data
GEMINI_API_KEY=

# Optional: use a model available to your Gemini account.
# GEMINI_MODEL=

# Enable only when intentionally blocking all external AI requests locally.
# MOA_DISABLE_EXTERNAL_AI=1

# DART integration is specified in docs but has not been implemented yet.
# DART_API_KEY=

# Vercel Production only: server settings, never VITE_-prefixed.
# Do not put real values into this example or into Git.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# Legacy fallback only when a new secret key is unavailable:
# SUPABASE_SERVICE_ROLE_KEY=
# MOA_APP_ORIGIN=https://your-production-domain.vercel.app
# Activation acknowledgement, NOT authentication:
# Set only after Vercel Authentication / All Deployments has been verified.
# MOA_ACCESS_POLICY=vercel-authentication-all
